{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": "worker.ts",
  "name": "cleaning-winter-haven",
  "compatibility_date": "2026-07-05",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "cleaning-winter-haven"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "kv_namespaces": [
    {
      "binding": "BOOKING_OUTBOX",
      "id": "REPLACE_WITH_BOOKING_OUTBOX_KV_ID",
      "preview_id": "REPLACE_WITH_BOOKING_OUTBOX_KV_PREVIEW_ID"
    }
  ],
  "vars": {
    "BOOKING_BROOM_API_KEY": "bb_winter-haven_n_iC6KZ_ssqVtiXtoaUZkFB_Spg-Ckmf"
  }
}
